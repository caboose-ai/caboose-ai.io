# Local bind address. Use 0.0.0.0 only for intentional LAN exposure.
HOMELAB_BIND_ADDRESS=127.0.0.1

# Authentik bootstrap and runtime secrets.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME
AUTHENTIK_BOOTSTRAP_TOKEN=CHANGE_ME
AUTHENTIK_SECRET_KEY=CHANGE_ME
AUTHENTIK_PG_PASS=CHANGE_ME

# Core service runtime secrets.
WOODPECKER_AGENT_SECRET=CHANGE_ME
WOODPECKER_GITEA_CLIENT=CHANGE_ME
WOODPECKER_GITEA_SECRET=CHANGE_ME
GITEA_ADMIN_PASSWORD=CHANGE_ME
FORGEJO_ADMIN_USERNAME=auth-admin
PORTAINER_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
SONAR_DB_PASS=CHANGE_ME
SONAR_ADMIN_PASSWORD=CHANGE_ME
GHOST_DB_PASS=CHANGE_ME
MATTERMOST_DB_PASS=CHANGE_ME
MATTERMOST_ADMIN_PASSWORD=CHANGE_ME

# Service OAuth credentials generated by configurators.
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=CHANGE_ME
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=CHANGE_ME
OPEN_WEBUI_OAUTH_CLIENT_ID=CHANGE_ME
OPEN_WEBUI_OAUTH_CLIENT_SECRET=CHANGE_ME
HOMARR_OIDC_CLIENT_ID=CHANGE_ME
HOMARR_OIDC_CLIENT_SECRET=CHANGE_ME
MCP_OAUTH_CLIENT_ID=CHANGE_ME
MCP_OAUTH_CLIENT_SECRET=CHANGE_ME

# Homarr runtime.
HOMARR_SECRET_ENCRYPTION_KEY=CHANGE_ME
HOMARR_BASE_URL=https://caboose-ai.io
HOMARR_OIDC_ISSUER=https://auth.caboose-ai.io/application/o/homarr/
HOMARR_LOGOUT_REDIRECT_URL=https://auth.caboose-ai.io/application/o/homarr/end-session/

# Paperclip optional profile.
PAPERCLIP_DB_PASS=CHANGE_ME
PAPERCLIP_DB_BIND_ADDRESS=127.0.0.1
PAPERCLIP_AUTH_SECRET=CHANGE_ME
PAPERCLIP_PUBLIC_URL=https://paperclip.caboose-ai.io
PAPERCLIP_API_KEY=
PAPERCLIP_WORKSPACE_ROOT=/home/caboose/dev/caboose-ai.io
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional public/social/Cloudflare credentials.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
HOMELAB_TUNNEL_ID=
HOMELAB_TUNNEL_CREDENTIALS_FILE=
HOMELAB_TUNNEL_ORIGIN=https://127.0.0.1:443
