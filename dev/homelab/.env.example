# Forgejo OIDC — configure via Forgejo Admin UI (Authentication Sources)
# OIDC Discovery: https://auth.caboose-ai.io/application/o/forgejo/.well-known/openid-configuration
FORGEJO_OAUTH_CLIENT_ID=CHANGE_ME
FORGEJO_OAUTH_CLIENT_SECRET=CHANGE_ME
# Portainer OIDC — configure via Portainer Settings > Authentication > OAuth
# Auth URL: https://auth.caboose-ai.io/application/o/authorize/
# Token URL: https://auth.caboose-ai.io/application/o/token/
# User info URL: https://auth.caboose-ai.io/application/o/userinfo/
PORTAINER_OAUTH_CLIENT_ID=CHANGE_ME
PORTAINER_OAUTH_CLIENT_SECRET=CHANGE_ME
# Mattermost OIDC — configure via /opt/mattermost/config/config.json GitLabSettings (requires sudo)
# Auth URL: https://auth.caboose-ai.io/application/o/authorize/
# Token URL: https://auth.caboose-ai.io/application/o/token/
# User API URL: https://auth.caboose-ai.io/application/o/userinfo/
MATTERMOST_OAUTH_CLIENT_ID=CHANGE_ME
MATTERMOST_OAUTH_CLIENT_SECRET=CHANGE_ME

